# SIGNALYN — Phase 7B.3: Hardened Story Intelligence Migration Job Container
FROM node:22-slim

WORKDIR /app

# Install dependencies required for migration
COPY package.json package-lock.json* ./
RUN npm install --omit=dev --legacy-peer-deps && npm install -g tsx

# Copy full static dependency closure
COPY tsconfig.json ./
COPY firebase-applet-config.json ./
COPY src/types.ts ./src/types.ts
COPY src/utils/categoryModel.ts ./src/utils/categoryModel.ts
COPY src/services/productAuditRegistry.ts ./src/services/productAuditRegistry.ts
COPY src/services/canonicalEntities.ts ./src/services/canonicalEntities.ts
COPY src/server/clustering/evidenceVerificationService.ts ./src/server/clustering/evidenceVerificationService.ts
COPY src/server/clustering/huaweiCompetitiveService.ts ./src/server/clustering/huaweiCompetitiveService.ts
COPY src/server/clustering/storyIdentityService.ts ./src/server/clustering/storyIdentityService.ts
COPY src/server/migration/storyIntelligenceJob.ts ./src/server/migration/storyIntelligenceJob.ts

ENV NODE_ENV=production
ENV FIREBASE_PROJECT_ID=signalyn-5406e
ENV FIREBASE_DATABASE_ID=ai-studio-signalyn-4ae53645-c201-40dc-b0f8-89d40cdf8d34
ENV MIGRATION_MODE=DRY_RUN
ENV MIGRATION_ALLOW_MUTATIONS=false

ENTRYPOINT ["tsx", "src/server/migration/storyIntelligenceJob.ts"]
