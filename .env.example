# ==============================================================================
# SIGNALYN ENVIRONMENT CONFIGURATION
# Target Firebase Project: signalyn-5406e
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT ENVIRONMENT VARIABLES (Safe for browser / VITE_ prefix)
# These public identifiers configure the client Firebase SDK to connect to signalyn-5406e.
# They are bundled into frontend assets and do not expose administrative privileges.
# ------------------------------------------------------------------------------
VITE_FIREBASE_PROJECT_ID="signalyn-5406e"
VITE_FIREBASE_APP_ID="1:971398888151:web:a70a18d114400c9b334e92"
VITE_FIREBASE_API_KEY="AIzaSyAvs-R1f3u7xcdVP58jlPJ5hvZkZH8Rp9I"
VITE_FIREBASE_AUTH_DOMAIN="signalyn-5406e.firebaseapp.com"
VITE_FIREBASE_DATABASE_ID="ai-studio-signalyn-4ae53645-c201-40dc-b0f8-89d40cdf8d34"
VITE_FIREBASE_STORAGE_BUCKET="signalyn-5406e.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="971398888151"

# ------------------------------------------------------------------------------
# 2. SERVER-ONLY ENVIRONMENT VARIABLES (Never expose to browser / No VITE_ prefix)
# Used exclusively by the Express backend and ingestion collector.
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV="development"
DISABLE_HMR="false"

# Keep off during deployment. Enable only on a compatible revision after rollout verification.
SIGNALYN_ENABLE_PERMANENT_ARTICLE_DELETION="false"

# APP_URL: Cloud Run / Hosting service URL for callbacks and internal routing
APP_URL="MY_APP_URL"

# Server-side Gemini API key (server-side proxy only)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Server administrator identity (matched against verified Firebase ID token)
SIGNALYN_OWNER_EMAIL="n.kalogerogiannis@gmail.com"
SIGNALYN_OWNER_UID=""

# Optional server-to-server admin secret for automated cron callers
ANALYSIS_ADMIN_KEY="OPTIONAL_ADMIN_SECRET"

# Firebase Admin SDK Configuration (targets named database via Google ADC)
FIREBASE_PROJECT_ID="signalyn-5406e"
FIREBASE_DATABASE_ID="ai-studio-signalyn-4ae53645-c201-40dc-b0f8-89d40cdf8d34"

# ------------------------------------------------------------------------------
# 3. GOOGLE CLOUD SCHEDULER OIDC CONFIGURATION (Phase 6B)
# Used to authenticate automated daily pipeline triggers from Google Cloud Scheduler.
# ------------------------------------------------------------------------------
# Dedicated Google Cloud Service Account email attached to Cloud Scheduler:
SCHEDULER_SERVICE_ACCOUNT_EMAIL="signalyn-scheduler@signalyn-5406e.iam.gserviceaccount.com"

# Expected OIDC Audience configured on Cloud Scheduler HTTP target:
SCHEDULER_TARGET_AUDIENCE="https://hw-signalyn.ai.studio/api/pipeline/scheduled-run"

# Scheduled Pipeline Execution Limits (Server-side enforced):
SCHEDULED_PIPELINE_MAX_ARTICLES="15"
SCHEDULED_PIPELINE_DEADLINE_MS="240000"
