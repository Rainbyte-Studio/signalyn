FROM node:22.23.5-bookworm-slim@sha256:d20a7b8b4184bf74fe77499b5460a3d69e582bc733d50287e40c3fe791764851 AS node-base
WORKDIR /app

FROM node-base AS frontend
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY index.html server.ts tsconfig.json vite.config.ts firebase-applet-config.json ./
COPY src/ ./src/
ARG SOURCE_SHA
ARG SOURCE_COMMIT_TIMESTAMP
RUN node -e 'const [sha, timestamp] = process.argv.slice(1); if (!/^[a-f0-9]{40}$/.test(sha) || !Number.isFinite(Date.parse(timestamp))) process.exit(1)' "$SOURCE_SHA" "$SOURCE_COMMIT_TIMESTAMP" \
    && VITE_GIT_COMMIT_SHA="$SOURCE_SHA" VITE_BUILD_TIMESTAMP="$SOURCE_COMMIT_TIMESTAMP" VITE_DEPLOYMENT_ENV=cloud-run-production npm run build \
    && test -s dist/index.html \
    && node -e 'const manifest = require("./dist/release-metadata.json"); if (manifest.commitSha !== process.argv[1]) process.exit(1)' "$SOURCE_SHA"

FROM node-base AS runtime
ARG SOURCE_SHA
LABEL org.opencontainers.image.revision=$SOURCE_SHA
ENV NODE_ENV=production
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund \
    && node --import tsx -e 'void 0' \
    && npm cache clean --force
COPY server.ts tsconfig.json vite.config.ts firebase-applet-config.json ./
COPY src/ ./src/
COPY --from=frontend /app/dist/ ./dist/
USER node
EXPOSE 8080
ENTRYPOINT ["node", "--import", "tsx", "server.ts", "--port", "8080"]
